{
    "name": "ryzecompany/invmenu",
    "description": "Virtual inventory API for multiversion RyzeMP",
    "type": "library",
    "homepage": "https://github.com/RyzeCompany/InvMenu",
    "license": "GPL-3.0-only",
    "keywords": ["pocketmine", "ryzemp", "minecraft", "bedrock", "inventory", "virion"],
    "require": {
        "php": "^8.1",
        "ryzemcbe/ryzemp": "^5.44.2-p1"
    },
    "replace": {
        "muqsit/invmenu": "self.version"
    },
    "autoload": {
        "classmap": ["src"]
    },
    "authors": [
        {
            "name": "Muqsit",
            "email": "hackhack05@gmail.com"
        },
        {
            "name": "RyzeCompany",
            "homepage": "https://github.com/RyzeCompany"
        }
    ],
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "muqsit\\invmenu"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php ryzemp",
            "@php tests/run.php pocketmine"
        ]
    },
    "support": {
        "source": "https://github.com/RyzeCompany/InvMenu"
    },
    "archive": {
        "exclude": ["/.github", "/tests", "/.poggit.yml"]
    }
}

